#pragma code_page(65001)
#include <winres.h>
// GC_VER_* come from build.rs (the app version in tauri.conf.json).
#define STR2(x) #x
#define STR(x) STR2(x)
#define GC_VER_STR STR(GC_VER_MAJOR) "." STR(GC_VER_MINOR) "." STR(GC_VER_PATCH)

1 ICON "../../src-tauri/icons/icon.ico"
1 RT_MANIFEST "setup.manifest"

// File details shown in Properties → Details; antivirus heuristics also
// treat an exe without them with more suspicion.
1 VERSIONINFO
FILEVERSION GC_VER_MAJOR, GC_VER_MINOR, GC_VER_PATCH, 0
PRODUCTVERSION GC_VER_MAJOR, GC_VER_MINOR, GC_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "GeniusClip"
      VALUE "FileDescription", "GeniusClip Setup"
      VALUE "FileVersion", GC_VER_STR
      VALUE "InternalName", "GeniusClip-Setup"
      VALUE "LegalCopyright", "© 2026 GeniusClip"
      VALUE "OriginalFilename", "GeniusClip-Setup.exe"
      VALUE "ProductName", "GeniusClip"
      VALUE "ProductVersion", GC_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
